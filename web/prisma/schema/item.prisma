model User_Item {
    id String @id @default(cuid())

    userId String

    name        String
    description String?           @db.VarChar(500)
    note        String?           @db.VarChar(500)
    status      STATUS_COMPLETION @default(NOT_STARTED)
    completedAt DateTime?

    tags  Tag[] // tags personali dell'utente per l'item
    lists List_UserItem[] // liste in cui l'utente ha inserito l'item

    isHidden Boolean @default(false) // nasconde l'elemento agli amici > PREMIUM

    categoryId String
    category   Category @relation(fields: [categoryId], references: [id])

    usedInChallenge GroupUser_Challenge[]

    ratings Rating[]

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, name, categoryId])
    @@index([status])
    @@index([categoryId])
}
