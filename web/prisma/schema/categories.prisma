model Category {
    id String @id @default(cuid())

    name String // testo originale/canonico, mostrato quando manca una traduzione (admin lo edita come "nome base")
    translations Json? // { en?: string }, traduzioni aggiuntive per nome — fallback su `name` se lingua assente
    icon String

    items                User_Item[] // item personali con questa categoria
    includedInCategories ListCategory[] // macro-categorie che includono questa categoria
    challenges           GroupChallenge[] // sfide che richiedono questa categoria

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([name])
    @@index([name])
}
